<BaseLayout title={"Rynox - Creative Agency Portfolio HTML Template"} description={"Rynox - Creative Agency Portfolio HTML Template"} bodyClass={"bg-dark text-light"} lang="en">
<!-- Start Breadcrumb 
    ============================================= -->
    <div class="breadcrumb-area text-center bg-gray bg-cover" style="background-image: url(/assets/img/shape/3.jpg);">
        <div class="container">
            <div class="breadcrumb-item">
                <div class="row">
                    <div class="col-lg-7 mx-auto">
                        <h1>Innovative services for creative businesses</h1>
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb">
                                <li><a href="#"><i class="fas fa-home"></i> Home</a></li>
                                <li class="active">Services</li>
                            </ol>
                        </nav>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- End Breadcrumb -->

    <!-- Start Services 
    ============================================= -->
    <div class="services-style-one-area default-padding-top overflow-hidden">
        <div class="container">
            <div class="row">
               <div class="col-xl-12">
                  <div class="card-wrap services-style-one-items">
      
                    <!-- Single Item  -->
                    <div class="card-item">
                        <div class="services-style-one-item">
                            <div class="icon">
                                <img src="/assets/img/icon/1.png" alt="Image Not Found">
                            </div>
                            <div class="info">
                                <h2><a href="/services-details/">Website design</a></h2>
                                <p>
                                    Process of planning, creating, and arranging the visual layout and user experience of a website on the internet. It focuses on how a website looks and how users interact with it.
                                </p>
                            </div>
                        </div>
                    </div>
                    <!-- End Single Item  -->
                    <!-- Single Item  -->
                    <div class="card-item">
                        <div class="services-style-one-item">
                            <div class="icon">
                                <img src="/assets/img/icon/2.png" alt="Image Not Found">
                            </div>
                            <div class="info">
                                <h2><a href="/services-details/">Hosting & Security</a></h2>
                                <p>
                                    Protecting a website, server, and hosting environment from hackers, malware, data theft, and other cyber threats. It ensures that your website user data remain safe.
                                </p>
                            </div>
                        </div>
                    </div>
                    <!-- End Single Item  -->
                    <!-- Single Item  -->
                    <div class="card-item">
                        <div class="services-style-one-item">
                            <div class="icon">
                                <img src="/assets/img/icon/3.png" alt="Image Not Found">
                            </div>
                            <div class="info">
                                <h2><a href="/services-details/">Content Writing</a></h2>
                                <p>
                                    The process of planning, creating, and editing written material for digital or physical platforms, such as blog posts, articles, web pages, and scripts. It focuses on informing.
                                </p>
                            </div>
                        </div>
                    </div>
                    <!-- End Single Item  -->
                    <!-- Single Item  -->
