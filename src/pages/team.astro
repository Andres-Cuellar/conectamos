---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title={"Rynox - Creative Agency Portfolio HTML Template"} description={"Rynox - Creative Agency Portfolio HTML Template"} bodyClass={"bg-dark text-light"} lang="en">
<!-- Start Team 
    ============================================= -->
    <div class="team-style-one-area overflow-hidden bg-gray default-padding-bottom pt-240 pt-md-110 pt-xs-70">
        <div class="container">
            <div class="row">
                <div class="col-lg-6 offset-lg-3">
                    <div class="site-heading text-center">
                        <div class="sub-title">Team Experts</div>
                        <div class="title split-text">Meet our talent for <br> Professional solution</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <!-- Single Item -->
                    <div class="team-style-one-item hover-reveal-item">
                        <div class="content">
                            <div class="left-info">
                                <div class="title-info">
                                    <h3><a href="/team-details/">Aleesha Brown</a></h3>
                                    <span>CEO & Founder</span>
                                </div>
                                <ul>
                                    <li>Customer Value</li>
                                    <li>Design Thinking</li>
                                    <li>Management</li>
                                </ul>
                            </div>
                            <ul class="social">
                                <li>
                                    <a href="#">
                                        <div class="icon">
                                            <svg width="14" height="13" viewBox="0 0 14 13" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                <path fill-rule="evenodd" clip-rule="evenodd" d="M4.41177 0H0L5.23083 7.06953L0.334618 13H2.59681L6.29998 8.51461L9.58823 12.9588H14L8.6172 5.68381L8.62673 5.69636L13.2614 0.0825854H10.9992L7.55741 4.25145L4.41177 0ZM2.43522 1.2381H3.80866L11.5648 11.7206H10.1913L2.43522 1.2381Z" fill="currentcolor"></path>
                                            </svg>
                                        </div>
                                        <span>Twitter</span>
                                    </a>
                                </li>
                                <li>
                                    <a href="#">
                                        <div class="icon"><i class="fab fa-facebook-f"></i></div>
                                        <span>Facebook</span>
                                    </a>
                                </li>
                            </ul>
                        </div>
                        <div class="reveal-hover-thumb">
                            <img src="/assets/img/team/6.jpg" alt="Image Not Found">
                        </div>
                    </div>
                    <!-- End Single Item -->
                    <!-- Single Item -->
                    <div class="team-style-one-item hover-reveal-item">
                        <div class="content">
                            <div class="left-info">
                                <div class="title-info">
                                    <h3><a href="/team-details/">Kevin Martin</a></h3>
                                    <span>Product Manager</span>
                                </div>
                                <ul>
                                    <li>Product Strategy</li>
                                    <li>Roadmap Planning</li>
                                    <li>Collaboration</li>
                                </ul>
                            </div>
                            <ul class="social">
                                <li>
                                    <a href="#">
                                        <div class="icon">
                                            <svg width="14" height="13" viewBox="0 0 14 13" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                <path fill-rule="evenodd" clip-rule="evenodd" d="M4.41177 0H0L5.23083 7.06953L0.334618 13H2.59681L6.29998 8.51461L9.58823 12.9588H14L8.6172 5.68381L8.62673 5.69636L13.2614 0.0825854H10.9992L7.55741 4.25145L4.41177 0ZM2.43522 1.2381H3.80866L11.5648 11.7206H10.1913L2.43522 1.2381Z" fill="currentcolor"></path>
                                            </svg>
                                        </div>
                                        <span>Twitter</span>
