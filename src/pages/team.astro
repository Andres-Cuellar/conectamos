                            </ul>
                        </div>
                        <div class="reveal-hover-thumb">
                            <img src="/assets/img/team/7.jpg" alt="Image Not Found">
                        </div>
                    </div>
                    <!-- End Single Item -->
                    <!-- Single Item -->
                    <div class="team-style-one-item hover-reveal-item">
                        <div class="content">
                            <div class="left-info">
                                <div class="title-info">
                                    <h3><a href="/team-details/">Sarah Albert</a></h3>
