---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactSection from '../components/ContactSection.astro';
---
<BaseLayout title="Contacto | Conectamos Growth Marketing" bodyClass="color-secondary contact-page">
<!-- Start Breadcrumb 
    ============================================= -->
    <div class="breadcrumb-area text-center text-light bg-gray bg-cover" style="background-image: url(/assets/img/shape/3.jpg);">
        <div class="container">
            <div class="breadcrumb-item">
                <div class="row">
                    <div class="col-lg-7 mx-auto">
                        <h1>Contacto</h1>
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb">
                                <li><a href="/"><i class="fas fa-home"></i> Inicio</a></li>
                                <li class="active">Contacto</li>
                            </ol>
                        </nav>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- End Breadcrumb -->

    <ContactSection />

    <!-- Start Map 
    ============================================= -->
    <div class="maps-area default-padding-bottom overflow-hidden">
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <div class="google-maps">
                        <iframe src="https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d48388.929990966964!2d-74.00332!3d40.711233!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x89c24fa5d33f083b%3A0xc80b8f06e177fe62!2sNew%20York%2C%20NY!5e0!3m2!1sen!2sus!4v1653598669477!5m2!1sen!2sus"></iframe>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- End Map -->
</BaseLayout>

<style>
    .breadcrumb li,
    .breadcrumb li::after {
        color: var(--white);
    }

    @media (min-width: 1024px) {
        :global(.contact-page .navbar.nav-full-width:not(.sticked) .attr-right .attr-nav li.side-menu > a) {
            color: var(--white);
        }

        :global(.contact-page .navbar:not(.sticked) .attr-nav .side-menu .line span) {
            background: var(--white);
        }
    }
</style>
