---
import { site, navigation, addresses, socialLinks } from "../data/site";

interface Props {
  home?: boolean;
  dark?: boolean;
}
const { home = false, dark = false } = Astro.props;
const sectionHref = (href: string) => !home && href.startsWith('#') ? `/${href}` : href;
---

<header>
  <!-- Start Navigation -->
  <nav
    class="navbar mobile-sidenav navbar-sticky navbar-default validnavs nav-full-width navbar-fixed"
  >
    <div class="container d-flex justify-content-between align-items-center">
      <!-- Start Header Navigation -->
      <div class="navbar-header">
        <a class="navbar-brand" href="/">
          <img
            alt="Logo"
            class="logo"
            src={dark ? site.logos.dark : site.logos.light}
          />
        </a>
      </div>
      <!-- End Header Navigation -->
      <!-- Collect the nav links, forms, and other content for toggling -->
      <div class="collapse navbar-collapse" id="navbar-menu"></div>
      <div class="attr-right">
        <!-- Start Atribute Navigation -->
        <div class="attr-nav flex">
          <ul>
            <li class="side-menu">
              <a
                href="#"
                role="button"
                aria-controls="site-menu"
                aria-expanded="false"
                aria-label="Abrir menú"
              >
                <strong>MENÚ </strong>
                <div class="line">
                  <span class="bar-1"></span>
                  <span class="bar-2"></span>
                  <span class="bar-3"></span>
                </div>
              </a>
            </li>
            <li>
              <a class="btn-style-one btn-sm" href={site.contactHref}>
                <div class="icon">
                  <svg
                    fill="none"
                    height="18"
                    viewbox="0 0 20 18"
                    width="20"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path
                      d="M1 17L17 1H7.8"
                      stroke="var(--color-icon)"
                      stroke-width="2"></path>
                  </svg>
                </div>
                <span>Quiero asesoría gratis</span>
                <div class="icon">
                  <svg
                    fill="none"
                    height="18"
                    viewbox="0 0 20 18"
                    width="20"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path
                      d="M1 17L17 1H7.8"
                      stroke="var(--color-icon)"
                      stroke-width="2"></path>
                  </svg>
                </div>
              </a>
            </li>
          </ul>
        </div>
        <!-- End Atribute Navigation -->
        <!-- Start Side Menu -->
        <div class="side" id="site-menu">
          <a class="close-side" href="#">Cerrar ×</a>
          <div class="container full-nav-attr-logo">
            <div class="row">
              <div class="col-lg-12">
                <div class="widget">
                  <div class="logo">
                    <a href="/"
                      ><img
                        alt="Logo"
                        src={dark ? site.logos.dark : site.logos.light}
                      /></a
                    >
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="container">
            <div class="row">
              <div class="col-xl-7 col-lg-7">
                <div class="side-navbar-inner">
                  <div class="simple-menu">
                    <ul class="simple-menu-list">
                      {
                        navigation.map((item) => (
                          <li>
                            <a href={sectionHref(item.href)}>{item.label}</a>
                          </li>
                        ))
                      }
                    </ul>
                  </div>
                </div>
              </div>
              <div class="col-xl-4 offset-xl-1 col-lg-4 offset-lg-1">
                <div class="side-widgets">
                  <div class="widget address">
                    <div>
                      <ul>
                        {
                          addresses.map((item) => (
                            <li>
                              <div class="content">
                                <>
                                  <p>{item.city}</p>
                                  <strong>{item.address}</strong>
                                </>
                              </div>
                            </li>
                          ))
                        }
                      </ul>
                    </div>
                  </div>
                  <div class="widget newsletter">
                    <h4>Déjanos tu contacto aquí</h4>
                    <a class="btn-standard" href={site.contactHref}
                      >Quiero diagnóstico digital gratis</a
                    >
                  </div>
                  <div class="widget social">
                    <ul class="link">
                      {
                        socialLinks.map((item) => (
                          <li>
                            <a href={item.href} aria-label={item.label}>
                              <i
                                class={`fab fa-${item.icon}`}
                                aria-hidden="true"
                              />
                            </a>
                          </li>
                        ))
                      }
                    </ul>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <!-- End Side Menu -->
      </div>
      <!-- Main Nav -->
    </div>
    <!-- Overlay screen for menu -->
    <div class="overlay-screen"></div>
    <!-- End Overlay screen for menu -->
  </nav>
  <!-- End Navigation -->
</header>
<script>
  const header = document.querySelector("header");
  const toggle = header?.querySelector<HTMLAnchorElement>(".side-menu > a");
  const panel = header?.querySelector<HTMLElement>("#site-menu");
  const nav = header?.querySelector("nav");

  const closeMenu = (restoreFocus = false) => {
    panel?.classList.remove("on");
    nav?.classList.remove("pause-sticked");
    document.body.classList.remove("on-side");
    header?.querySelector(".overlay-screen")?.classList.remove("opened");
    toggle?.setAttribute("aria-expanded", "false");
    if (restoreFocus) toggle?.focus();
  };

  // Observe the existing plugin so accessibility state does not depend on event-handler order.
  if (panel && toggle) {
    new MutationObserver(() => {
      toggle.setAttribute(
        "aria-expanded",
        String(panel.classList.contains("on")),
      );
    }).observe(panel, { attributes: true, attributeFilter: ["class"] });
  }
  toggle?.addEventListener("keydown", (event) => {
    if (event.key === " ") {
      event.preventDefault();
      toggle.click();
    }
  });
  header
    ?.querySelectorAll<HTMLAnchorElement>(
      '.simple-menu-list a, .side .btn-standard',
    )
    .forEach((link) => link.addEventListener("click", () => closeMenu()));
  header
    ?.querySelector(".close-side")
    ?.addEventListener("click", () => closeMenu(true));
  header
    ?.querySelector(".overlay-screen")
    ?.addEventListener("click", () => closeMenu(true));
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && panel?.classList.contains("on"))
      closeMenu(true);
  });
</script>

<style>
  .widget.newsletter .btn-standard {
    width: auto;
    max-width: 100%;
    height: auto;
    min-height: 50px;
    margin-top: 15px;
    padding: 12px 24px;
    line-height: 1.3;
    border-radius: 30px;
    text-align: center;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    transition: all 0.35s ease-in-out;
  }

  .widget.newsletter .btn-standard:hover {
    width: auto;
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--white);
  }
</style>
