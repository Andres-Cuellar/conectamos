---
import { site } from "../data/site";
import ProjectScrollShowcase from "./ProjectScrollShowcase.astro";

const showBlog = false;
---

<!-- Start Banner 
    ============================================= -->
<div class="banner-style-one-area bg-gray" id="inicio">
    <div class="container">
        <div class="content">
            <div class="row hero-intro-row">
                <div class="col-xl-6 offset-xl-1 hero-title-column">
                    <h2>
                        Conectamos
                        <strong
                            >Growth<img
                                alt=""
                                src="/assets/img/icon/star-primary.png"
                            /></strong
                        >
                        <strong>Marketing</strong>
                    </h2>
                </div>
                <div class="col-xl-3 hero-tagline-column">
                    <p class="banner-tagline">
                        Más que una agencia, tu equipo de estrategia digital.
                    </p>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-xl-4">
                <p class="quotes">
                    Si tu marca está en redes, pero no vende… Si tu publicidad
                    no convierte… Si tu contenido es un desorden…
                </p>
            </div>
            <div class="col-xl-4 offset-xl-4">
                <div class="video-card">
                    <a
                        aria-label="Quiero asesoría gratis"
                        class=""
                        href={site.contactHref}
                        ><i class="fas fa-arrow-right"></i></a
                    >
                    <p>Quiero asesoría gratis</p>
                </div>
            </div>
        </div>
    </div>
    <div class="relative overflow-hidden mt-60">
        <div class="home-container">
            <video autoplay="" loop="" muted="" src="/assets/video/2.mp4"
            ></video>
        </div>
    </div>
</div>
<!-- End Banner -->
<!-- Start About 
    ============================================= -->
<div class="text-scroll-items default-padding-top text-center">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="about-one-info">
                    <div class="text-move-wrapper">
                        <h2 class="text-move-item">Conectamos</h2>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- End About -->
<!-- Start About 
    ============================================= -->
<div class="about-style-one-area text-move-destination default-padding">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="about-style-one-info text-scroll-animation">
                    <div class="icon">
                        <img
                            alt="Image Not Found"
                            src="/assets/img/about/1.jpg"
                        />
                    </div>
                    <div class="content">
                        <p class="text">
                            Tranquilo, no estás solo. Aquí estamos para
                            enchufarte a la estrategia correcta y conectarte con
                            tus clientes.
                        </p>
                        <a class="btn-style-one mt-10" href={site.contactHref}>
                            <div class="icon">
                                <svg
                                    fill="none"
                                    height="18"
                                    viewbox="0 0 20 18"
                                    width="20"
                                    xmlns="http://www.w3.org/2000/svg"
                                >
                                    <path
                                        d="M1 17L17 1H7.8"
                                        stroke="#232323"
                                        stroke-width="2"></path>
                                </svg>
                            </div>
                            <span>Quiero diagnóstico digital gratis</span>
                            <div class="icon">
                                <svg
                                    fill="none"
                                    height="18"
                                    viewbox="0 0 20 18"
                                    width="20"
                                    xmlns="http://www.w3.org/2000/svg"
                                >
                                    <path
                                        d="M1 17L17 1H7.8"
                                        stroke="#232323"
                                        stroke-width="2"></path>
                                </svg>
                            </div>
                        </a>
                    </div>
                    <div class="right-info">
                        <ul class="fun-fact-style-three">
                            <li>
                                <h2>ROAS publicidad</h2>
                                <div class="js-counter">+20</div>
                            </li>
                        </ul>
                        <div class="thumb mb--50">
                            <img
                                alt="Image Not Found"
                                class="upDownScrol"
                                src="/assets/img/about/2.jpg"
                            />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- End About -->
<!-- Start Services 
    ============================================= -->
<div
    class="services-style-one-area default-padding-top bg-gray overflow-hidden"
    id="servicios"
>
    <div class="container">
        <div class="row">
            <div class="col-lg-6 offset-lg-3 col-md-8">
                <div class="site-heading">
                    <div class="sub-title">SERVICIOS</div>
                    <div class="title split-text">
                        Lo que hacemos (y hacemos bien 👇)
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="container">
        <div class="row">
            <div class="col-xl-12">
                <div class="card-wrap services-style-one-items services-grid">
                    <div class="card-item">
                        <div class="services-style-one-item">
                            <div class="icon">
                                <img
                                    alt="Image Not Found"
                                    src="/assets/img/icon/5.png"
                                />
                            </div>
                            <div class="info">
                                <h2>
                                    <a href={site.contactHref}
                                        >Estrategia de contenido orgánico</a
                                    >
                                </h2>
                                <p>
                                    Publicar por publicar no sirve. Creamos
                                    contenido que engancha, entretiene y vende.
                                    Porque tu marca no necesita más posts,
                                    necesita una comunidad real.
                                </p>
                            </div>
                        </div>
                    </div><div class="card-item">
                        <div class="services-style-one-item">
                            <div class="icon">
                                <img
                                    alt="Image Not Found"
                                    src="/assets/img/icon/6.png"
                                />
                            </div>
                            <div class="info">
                                <h2>
                                    <a href={site.contactHref}
                                        >Estrategia de pauta publicitaria</a
                                    >
                                </h2>
                                <p>
                                    Meterle plata a los anuncios sin estrategia
                                    es tirar billetes al vacío. Aquí optimizamos
                                    cada centavo para que tu inversión en Meta
                                    Ads y Google Ads realmente convierta.
                                </p>
                            </div>
                        </div>
                    </div><div class="card-item">
                        <div class="services-style-one-item">
                            <div class="icon">
                                <img
                                    alt="Image Not Found"
                                    src="/assets/img/icon/7.png"
                                />
                            </div>
                            <div class="info">
                                <h2>
                                    <a
                                        href={`${site.projectsHref}#proyectos-audiovisuales`}
                                        >Producción audiovisual</a
                                    >
                                </h2>
                                <p>
                                    Videos que impactan, emocionan y venden.
                                    Desde reels dinámicos hasta videos
                                    corporativos y comerciales. Somos tu
                                    productora in-house.
                                </p>
                                <a
                                    class="btn-standard project-link"
                                    href={`${site.projectsHref}#proyectos-audiovisuales`}
                                    >Ver proyectos</a
                                >
                            </div>
                        </div>
                    </div><div class="card-item">
                        <div class="services-style-one-item">
                            <div class="icon">
                                <img
                                    alt="Image Not Found"
                                    src="/assets/img/icon/8.png"
                                />
                            </div>
                            <div class="info">
                                <h2>
                                    <a
                                        href={`${site.projectsHref}#proyectos-web`}
                                        >Diseño web que sí funciona</a
                                    >
                                </h2>
                                <p>
                                    Si tu web no vende, algo está mal. Creamos
                                    sitios optimizados, rápidos y diseñados para
                                    convertir.
                                </p>
                                <a
                                    class="btn-standard project-link"
                                    href={`${site.projectsHref}#proyectos-web`}
                                    >Ver proyectos</a
                                >
                            </div>
                        </div>
                    </div><div class="card-item">
                        <div class="services-style-one-item">
                            <div class="icon">
                                <img
                                    alt="Image Not Found"
                                    src="/assets/img/icon/5.png"
                                />
                            </div>
                            <div class="info">
                                <h2>
                                    <a href={site.contactHref}
                                        >Asesoría y acompañamiento en marketing</a
                                    >
                                </h2>
                                <p>
                                    Si tu estrategia necesita un reseteo, te
                                    guiamos en branding, conversión,
                                    automatización, gestión comercial y todo lo
                                    que haga falta para que tu negocio crezca.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- End Services -->
<!-- Start Why Choose Us 
    ============================================= -->
<div
    class="choose-us-style-two-area default-padding-top bg-gray shadow-shape-top"
    id="nosotros"
>
    <div class="container">
        <div class="brand-heading mb-100 mb-md-50 mb-xs-0">
            <div class="row">
                <div class="col-xl-5 col-lg-4">
                    <div class="sub-title">¿Por qué nosotros?</div>
                </div>
                <div class="col-xl-7 col-lg-8 text-scroll-animation">
                    <h2 class="title text">
                        <strong> Somos tu equipo de marketing </strong>
                        sin que tengas que contratar un departamento entero.
                        <span class="clients-lists">
                            <img
                                alt="Image Not Found"
                                src="/assets/img/team/1.jpg"
                            />
                            <img
                                alt="Image Not Found"
                                src="/assets/img/team/2.jpg"
                            />
                            <img
                                alt="Image Not Found"
                                src="/assets/img/team/3.jpg"
                            />
                        </span>
                    </h2>
                </div>
            </div>
        </div>
    </div>
    <div class="container container-large">
        <div class="grid-layout-items">
            <!-- Single Item -->
            <div class="grid-layout-item experience-cards">
                <img alt="" src="/assets/img/projects/img-4.jpg" />
                <div class="content">
                    <div class="counter-style-one">
                        <div class="counter">
                            <div class="fun-fact">
                                <div
                                    class="timer"
                                    data-speed="1000"
                                    data-to="20"
                                >
                                    20
                                </div>
                                <div class="operator">+</div>
                            </div>
                            <h2>años de experiencia combinada</h2>
                        </div>
                    </div>
                </div>
            </div>
            <!-- End Single Item -->
            <!-- Single Item -->
            <div class="grid-layout-item card-style-three">
                <img
                    alt="Image Not Found"
                    src="/assets/img/illustration/1.gif"
                />
                <div class="info">
                    <p>
                        Mientras otras agencias manejan cientos de cuentas y te
                        dejan en visto, nosotros elegimos proyectos en los que
                        realmente podemos hacer la diferencia.
                    </p>
                    <div class="customer-list">
                        <div class="teams">
                            <img
                                alt=""
                                src="/assets/img/projects/person-1.jpg"
                            />
                            <img
                                alt=""
                                src="/assets/img/projects/person-2.jpg"
                            />
                        </div>
                        <span> +5x </span>
                        <h3>Crecimiento digital</h3>
                    </div>
                </div>
            </div>
            <!-- End Single Item -->
            <!-- Single Item -->
            <div class="grid-layout-item project-card">
                <div class="info">
                    <h2>
                        Trabajamos con pocas marcas porque creemos en la
                        calidad, no en la cantidad.
                    </h2>
                    <div class="flex-item">
                        <div class="list-item-one mt-30 mt-md-10 mt-xs-10">
                            <ul>
                                <li>No vendemos humo.</li>
                                <li>No aplicamos estrategias genéricas.</li>
                                <li>
                                    Personalizamos cada plan según tu negocio.
                                </li>
                            </ul>
                        </div>
                        <a class="btn-style-one dark" href={site.projectsHref}>
                            <div class="icon">
                                <svg
                                    fill="none"
                                    height="18"
                                    viewbox="0 0 20 18"
                                    width="20"
                                    xmlns="http://www.w3.org/2000/svg"
                                >
                                    <path
                                        d="M1 17L17 1H7.8"
                                        stroke="#232323"
                                        stroke-width="2"
                                    >
                                    </path>
                                </svg>
                            </div>
                            <span> Ver proyectos </span>
                            <div class="icon">
                                <svg
                                    fill="none"
                                    height="18"
                                    viewbox="0 0 20 18"
                                    width="20"
                                    xmlns="http://www.w3.org/2000/svg"
                                >
                                    <path
                                        d="M1 17L17 1H7.8"
                                        stroke="#232323"
                                        stroke-width="2"
                                    >
                                    </path>
                                </svg>
                            </div>
                        </a>
                    </div>
                    <div class="project-list">
                        <img alt="" src="/assets/img/projects/img-1.jpg" />
                        <img alt="" src="/assets/img/projects/img-2.jpg" />
                        <img alt="" src="/assets/img/projects/img-3.jpg" />
                    </div>
                </div>
            </div>
            <!-- End Single Item -->
            <!-- Single Item -->
            <div class="grid-layout-item review-card">
                <div class="left-info">
                    <div class="ratings"></div>
                    <h2>
                        Si buscas una agencia que te acompañe de verdad, en
                        lugar de dejarte a la deriva con reportes llenos de
                        números sin contexto… Conectamos es para ti.
                    </h2>
                </div>
                <div class="icon">
                    <img
                        alt="Image Not Found"
                        src="/assets/img/illustration/3.png"
                    />
                </div>
            </div>
            <!-- End Single Item -->
        </div>
        <div class="why-benefits-grid">
            <article class="why-benefit-card">
                <h3>Atención inmediata</h3>
                <p>
                    No te haremos esperar días por una respuesta. Si tienes una
                    duda o necesitas un ajuste, aquí estamos.
                </p>
            </article>
            <article class="why-benefit-card">
                <h3>Estrategia a la medida</h3>
                <p>
                    No aplicamos fórmulas prefabricadas. Cada plan es único,
                    diseñado para que tu marca crezca con propósito.
                </p>
            </article>
            <article class="why-benefit-card">
                <h3>Detalles que marcan la diferencia</h3>
                <p>
                    Desde el tono de tus mensajes hasta la optimización de tus
                    anuncios, cuidamos cada aspecto para que tu estrategia sea
                    impecable.
                </p>
            </article>
            <article class="why-benefit-card">
                <h3>Disponibilidad real</h3>
                <p>
                    No eres “un cliente más”. Eres una marca con potencial, y
                    nosotros estamos aquí para hacer que brille.
                </p>
            </article>
        </div>
    </div>
</div>
<!-- End Why Choose Us -->
<!-- Start Project 
    ============================================= -->
<div
    class="project-style-three-area default-padding bg-gray case-studies"
    id="proyectos"
>
    <div class="container">
        <div class="row">
            <div class="col-xl-6 col-lg-8 mx-auto">
                <div class="large-heading">
                    <h1>
                        Casos de
                        <span> éxito </span>
                    </h1>
                </div>
            </div>
        </div>
    </div>
    <div class="container">
