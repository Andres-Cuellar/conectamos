<div class="tesimonial-style-one-area default-padding bg-gray">
    <div class="container">
        <div class="row">
            <div class="col-xl-6 offset-xl-3 col-lg-8 offset-lg-2">
                <div class="site-heading text-center">
                    <div class="sub-title fade-amin-item">Testimonials</div>
                    <div class="title split-text">Customer Success Stories</div>
                </div>
            </div>
        </div>
    </div>
    <div class="container">
        <div class="row">
            <div class="col-xl-4 ceo-quote-wrap">
                <div class="ceo-quote">
                    <img src="/assets/img/team/13.jpg" alt="Image Not Found" />
                    <a
                        href="https://www.youtube.com/watch?v=jzPvKmQrlMY"
                        class="popup-youtube video-btn"
                        ><i class="fas fa-play"></i></a
                    >
                </div>
            </div>
