---
import { site, navigation, addresses, socialLinks } from '../data/site';

interface Props {
  home?: boolean;
  dark?: boolean;
}
const { home = false, dark = false } = Astro.props;
const sectionHref = (href: string) => !home && href.startsWith('#') ? `/${href}` : href;
---
<footer class:list={['footer-style-two brand-footer text-light', dark ? 'bg-dark-secondary' : 'bg-dark']}>
  <div class="footer-invitation">
    <div class="container footer-invitation-inner">
      <p class="footer-slogan">¡Conectamos a nuestros clientes <strong>con sus clientes!</strong></p>
      <a class="footer-contact-cta" href={site.contactHref}>
        <span>Quiero asesoría gratis</span>
        <svg width="20" height="18" viewBox="0 0 20 18" fill="none" aria-hidden="true">
          <path d="M1 17L17 1H7.8" stroke="currentColor" stroke-width="2" />
        </svg>
      </a>
    </div>
  </div>
  <div class="container">
    <div class="footer-main">
      <div class="footer-brand">
        <a class="footer-logo-link" href="/" aria-label={`${site.name}: inicio`}>
          <img class="logo" src={dark ? site.logos.dark : site.logos.footer} alt={site.name} loading="lazy" />
        </a>
        <a class="footer-whatsapp" href={site.whatsapp.href} target="_blank" rel="noopener noreferrer">
          <i class="fab fa-whatsapp" aria-hidden="true"></i>
          <span>{site.whatsapp.label}</span>
        </a>
        <ul class="footer-social-links" aria-label="Redes sociales">
          {socialLinks.map((item) => (
            <li><a href={item.href}><i class={`fab fa-${item.icon}`} aria-hidden="true"></i><span>{item.label}</span></a></li>
          ))}
        </ul>
      </div>
      <nav class="footer-navigation" aria-label="Navegación del pie de página">
        <h2 class="footer-label">Conectamos</h2>
        <ul>
          {navigation.map((item) => <li><a href={sectionHref(item.href)}>{item.label}</a></li>)}
        </ul>
      </nav>
      <div class="footer-locations">
        <h2 class="footer-label">Nuestras sedes</h2>
        <div class="footer-addresses">
          {addresses.map((item) => <div><h3>{item.city}</h3><p>{item.address}</p></div>)}
        </div>
      </div>
    </div>
    <div class="brand-footer-bottom">
      <p>{site.name}</p>
      <a href={site.whatsapp.href} target="_blank" rel="noopener noreferrer">WhatsApp</a>
    </div>
  </div>
</footer>

<style>
  .footer-invitation {
    padding: 44px 0;
    background: var(--color-primary);
  }

  .footer-invitation-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
  }

  .footer-slogan {
    max-width: 25ch;
    margin: 0;
    font-size: clamp(28px, 3vw, 44px);
    font-weight: 600;
    line-height: 1.2;
    color: var(--white);
  }

  .footer-slogan strong {
    color: var(--color-secondary);
    font-weight: 800;
  }

  .footer-contact-cta {
    display: inline-flex;
    flex-shrink: 0;
    min-height: 52px;
    align-items: center;
    justify-content: center;
    gap: 24px;
    padding: 16px 24px;
    border-radius: 40px;
    background: var(--color-secondary);
    color: var(--color-heading);
    font-weight: 700;
    line-height: 1.3;
  }

  .footer-contact-cta span {
    color: inherit;
  }

  .footer-contact-cta:hover {
    background: var(--white);
    color: var(--color-heading);
  }

  .footer-main {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.65fr) minmax(0, 1fr);
    gap: 56px;
    padding: 64px 0 48px;
  }

  .footer-brand,
  .footer-navigation,
  .footer-locations {
    min-width: 0;
  }

  .footer-logo-link {
    display: inline-block;
    margin-bottom: 24px;
  }

  .footer-brand img.logo {
    width: auto;
    max-width: 240px;
    height: 64px;
    margin: 0;
    object-fit: contain;
  }

  .footer-whatsapp {
    display: flex;
    align-items: center;
    gap: 12px;
    width: fit-content;
    margin-bottom: 24px;
    font-size: clamp(20px, 2vw, 26px);
    font-weight: 600;
    line-height: 1.3;
    color: var(--white);
  }

  .footer-whatsapp i {
    color: var(--color-secondary);
  }

  .footer-whatsapp span {
    color: inherit;
  }

  .footer-social-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-social-links a {
    display: inline-flex;
    min-height: 40px;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    border: 1px solid rgb(255 255 255 / 20%);
    border-radius: 24px;
    font-size: 14px;
    line-height: 1.3;
    color: var(--white);
  }

  .footer-social-links a span {
    color: inherit;
  }

  .footer-social-links a:hover {
    border-color: var(--color-secondary);
    color: var(--color-secondary);
  }

  .footer-label {
    margin-bottom: 24px;
    font-size: 14px;
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-secondary);
  }

  .footer-navigation ul {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-navigation a {
    font-size: 16px;
    line-height: 1.5;
    color: var(--white);
  }

  .footer-addresses {
    display: grid;
    gap: 24px;
  }

  .footer-addresses h3 {
    margin-bottom: 8px;
    font-size: 20px;
    line-height: 1.3;
    color: var(--white);
  }

  .footer-addresses p {
    max-width: 30ch;
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--white-secondary);
  }

  .brand-footer-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 24px 0;
    border-top: 1px solid rgb(255 255 255 / 15%);
  }

  .brand-footer-bottom p,
  .brand-footer-bottom a {
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
    color: var(--white-secondary);
  }

  .footer-navigation a:hover,
  .footer-whatsapp:hover,
  .brand-footer-bottom a:hover {
    color: var(--color-secondary);
  }

  .brand-footer a:focus-visible {
    outline: 2px solid var(--color-secondary);
    outline-offset: 5px;
  }

  @media (max-width: 991px) {
    .footer-invitation-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 24px;
    }

    .footer-main {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 36px;
      padding-top: 48px;
    }

    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 575px) {
    .footer-main {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
      padding-bottom: 32px;
    }

    .footer-brand {
      grid-column: auto;
    }

    .footer-label {
      margin-bottom: 16px;
    }
  }
</style>
