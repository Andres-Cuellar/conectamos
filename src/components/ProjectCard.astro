---
import type { Project } from '../data/projects';
import { projectHref } from '../data/projects';

interface Props {
  project: Project;
  showAnchor?: boolean;
}
const { project, showAnchor = false } = Astro.props;
const href = projectHref(project.slug);
---
<article class="case-study-item" id={showAnchor ? project.anchor : undefined}>
  <div class="portfolio-style-one case-study">
    <a class="thumb" href={href} aria-label={project.title}>
      <img src={project.image} alt={project.imageAlt} loading="lazy" decoding="async" />
    </a>
    <div class="info">
      <h2><a href={href}>{project.title}</a></h2>
      <p class="case-study-summary">{project.excerpt}</p>
      <a class="btn-standard project-link" href={href} aria-label={`Ver proyecto: ${project.title}`}>Ver proyecto</a>
    </div>
  </div>
</article>
