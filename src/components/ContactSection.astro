<div
    class="contact-style-one-area default-padding"
    id="contacto"
>
    <div class="container">
        <div class="row">
            <div class="col-xl-5 contact-intro">
                <div class="contact-left-info fade-anim-item">
                    <div class="content">
                        <div class="sub-title">Déjanos tu contacto aquí</div>
                        <div class="title contact-intro-title">
                            ¿Quieres saber si tu <strong>estrategia digital</strong>
                            <strong>realmente está funcionando</strong>?
                        </div>
                        <p>
                            Déjanos tus datos y te hacemos un diagnóstico
                            digital gratuito o agenda tu primera asesoría sin
                            costo para analizar cómo mejorar tu presencia
                            online, optimizar tu pauta y hacer crecer tu marca.
                        </p>
                        <ul class="list-item-one">
                            <li>
                                ¡Conectamos a nuestros clientes con sus
                                clientes!
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
            <div
                class="col-xl-7 contact-right-info fade-anim-item pl-80 pl-md-15 pl-xs-15"
                data-delay="0.3"
            >
                <form
                    class="contact-form-style-one"
                    id="contact-form"
                    onsubmit="return false;"
                >
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="form-group">
                                <label for="name">Nombre y apellido:</label
                                ><input
                                    autocomplete="name"
                                    class="form-control"
                                    id="name"
                                    name="name"
                                    placeholder="Nombre y apellido"
                                    required=""
                                    type="text"
                                />
                            </div>
                        </div>
                    </div><div class="row">
                        <div class="col-lg-12">
                            <div class="form-group">
                                <label for="city">Ciudad:</label><input
                                    autocomplete="address-level2"
                                    class="form-control"
                                    id="city"
                                    name="city"
                                    placeholder="Ciudad"
                                    required=""
                                    type="text"
                                />
                            </div>
                        </div>
                    </div><div class="row">
                        <div class="col-lg-12">
                            <div class="form-group">
                                <label for="company">Empresa:</label><input
                                    autocomplete="organization"
                                    class="form-control"
                                    id="company"
                                    name="company"
                                    placeholder="Empresa"
                                    required=""
                                    type="text"
                                />
                            </div>
                        </div>
                    </div><div class="row">
                        <div class="col-lg-12">
                            <div class="form-group">
                                <label for="phone">Celular:</label><input
                                    autocomplete="tel"
                                    class="form-control"
                                    id="phone"
                                    name="phone"
                                    placeholder="Celular"
                                    required=""
                                    type="tel"
                                />
                            </div>
                        </div>
                    </div><div class="row">
                        <div class="col-lg-12">
                            <div class="form-group">
                                <label for="email">Correo:</label><input
                                    autocomplete="email"
                                    class="form-control"
                                    id="email"
                                    name="email"
                                    placeholder="Correo"
                                    required=""
                                    type="email"
                                />
                            </div>
                        </div>
                    </div><div class="row">
                        <div class="col-lg-12">
                            <div class="form-group">
                                <label for="preference">¿Qué prefieres?</label
                                ><select
                                    class="form-control"
                                    id="preference"
                                    name="preference"
                                    required=""
                                    ><option value="diagnostico"
                                        >Diagnóstico gratis</option
                                    ><option value="asesoria"
                                        >Asesoría gratis</option
                                    ></select>
                            </div>
                        </div>
                    </div><div class="row">
                        <div class="col-lg-12">
                            <div class="form-group comments">
                                <label for="links"
                                    >Si tienes redes sociales, sitio web, deja
                                    los links para analizarlas y hacer un
                                    DIAGNÓSTICO GRATIS.</label
                                ><textarea
                                    class="form-control"
                                    id="links"
                                    name="links"
                                    required=""></textarea>
                            </div>
                        </div>
                    </div><div class="row">
                        <div class="col-lg-12">
                            <button
                                class="btn-style-one"
                                disabled=""
                                id="submit"
                                name="submit"
                                type="submit"
                            >
                                <div class="icon">
                                    <svg
                                        fill="none"
                                        height="18"
                                        viewbox="0 0 20 18"
                                        width="20"
                                        xmlns="http://www.w3.org/2000/svg"
                                    >
                                        <path
                                            d="M1 17L17 1H7.8"
                                            stroke="#232323"
                                            stroke-width="2"></path>
                                    </svg>
                                </div>
                                <span>Quiero mi diagnóstico</span>
                                <div class="icon">
                                    <svg
                                        fill="none"
                                        height="18"
                                        viewbox="0 0 20 18"
                                        width="20"
                                        xmlns="http://www.w3.org/2000/svg"
                                    >
                                        <path
                                            d="M1 17L17 1H7.8"
                                            stroke="#232323"
                                            stroke-width="2"></path>
                                    </svg>
                                </div>
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .contact-intro-title {
        font-weight: 500;
    }

    .contact-intro-title strong {
        font-weight: 800;
    }

    .contact-form-style-one label {
        font-weight: 700;
        color: var(--color-heading);
    }

    @media (min-width: 1200px) {
        .contact-intro {
            position: sticky;
            top: var(--contact-sticky-top, 110px);
            align-self: flex-start;
        }
    }
</style>

<script>
    const intro = document.querySelector<HTMLElement>('.contact-intro');
    const nav = document.querySelector<HTMLElement>('header nav');

    if (intro) {
        const updateStickyOffset = () => {
            const headerOffset = (nav?.getBoundingClientRect().height ?? 86) + 24;
            // A tall text block can scroll into view before sticking, without an inner scrollbar.
            const availableOffset = window.innerHeight - intro.offsetHeight - 24;
            intro.style.setProperty('--contact-sticky-top', `${Math.min(headerOffset, availableOffset)}px`);
        };

        const observer = new ResizeObserver(updateStickyOffset);
        observer.observe(intro);
        if (nav) observer.observe(nav);
        window.addEventListener('resize', updateStickyOffset, { passive: true });
        updateStickyOffset();
    }
</script>
